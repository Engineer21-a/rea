#. {ph0}: <span translate="no">Node.js</span>
#: website/public/faq/index.html:135
#, python-brace-format
msgctxt "page:faq/index.html"
msgid ""
"With {ph0} and npm available, run setup, choose your coding agent and review"
" the proposed changes."
msgstr ""
"Uz dostupne {ph0} i npm pokreni postavljanje, odaberi svog agenta za "
"programiranje i pregledaj predložene promjene."

#: website/public/faq/index.html:142
msgctxt "page:faq/index.html"
msgid "Terminal · agent setup"
msgstr "Terminal · postavljanje agenta"

#: website/public/faq/index.html:143 website/public/faq/index.html:184
#: website/public/faq/index.html:202 website/public/faq/index.html:286
#: website/public/faq/index.html:333 website/public/faq/index.html:373
#: website/public/faq/index.html:393
