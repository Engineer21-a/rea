"{ph0}Address:{ph1} a location in the program, written in hexadecimal, such "
"as {ph2}."
msgstr ""
"{ph0}Adresa:{ph1} mjesto u programu, zapisano heksadecimalno, na primjer "
"{ph2}."

#. {ph0}: <strong>
#. {ph1}: </strong>
#: website/public/guides/native/index.html:165
#, python-brace-format
msgctxt "page:guides/native/index.html"
