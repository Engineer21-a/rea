msgid "Copy setup command"
msgstr "Kopiraj naredbu za postavljanje"

#: website/public/first-investigation/index.html:201
msgctxt "page:first-investigation/index.html"
msgid "Copy Notes investigation prompt"
msgstr "Kopiraj upit za istraživanje aplikacije Notes"

#: website/public/first-investigation/index.html:323
msgctxt "page:first-investigation/index.html"
